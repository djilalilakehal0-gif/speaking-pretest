# Copy to .env.local (never commit real secrets). All values are public at build time;
# only put URLs here, never API keys.

# HTTPS endpoint that accepts orders (see README "Ordering backend contract").
# Leave empty: checkout hands the order to the restaurant by phone/e-mail instead.
VITE_ORDER_ENDPOINT=

# HTTPS endpoint that accepts { email } newsletter signups.
# Leave empty: the newsletter form opens an e-mail to the restaurant instead.
VITE_NEWSLETTER_ENDPOINT=
