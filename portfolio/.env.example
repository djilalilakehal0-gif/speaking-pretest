# Copy to .env.local and fill in. Only NEXT_PUBLIC_* values reach the browser — never put secret API keys here.

# Sub-folder the site is served from (leave empty at a domain root).
NEXT_PUBLIC_BASE_PATH=

# Absolute site URL, used for Open Graph / canonical links.
NEXT_PUBLIC_SITE_URL=https://djilali.pages.dev

# Contact form endpoint that accepts a JSON POST {name,email,subject,message} (e.g. a Formspree form URL
# such as https://formspree.io/f/xxxxxxx, or your own serverless function). Public form endpoints are safe
# to expose; secret keys are not. Leave empty to fall back to opening the visitor's mail app.
NEXT_PUBLIC_CONTACT_ENDPOINT=
