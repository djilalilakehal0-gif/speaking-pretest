<?xml version="1.0" encoding="utf-8"?>
<!-- Counted phrases. Arabic uses all six plural forms (zero, one, two, few 3-10, many 11-99, other 100+). -->
<resources>
    <plurals name="say_folder_added">
        <item quantity="one">Folder added. I found %1$d document.</item>
        <item quantity="other">Folder added. I found %1$d documents.</item>
    </plurals>
    <plurals name="say_found_many">
        <item quantity="one">I found %1$d document: %2$s. Say “read it” to hear it.</item>
        <item quantity="other">I found %1$d documents. The first is %2$s. Say “read it” to hear it, or “next” for the next one.</item>
    </plurals>
    <plurals name="say_reading_start">
        <item quantity="one">Reading %1$s, %2$d page.</item>
        <item quantity="other">Reading %1$s, %2$d pages.</item>
    </plurals>
    <plurals name="say_notes_list">
        <item quantity="one">You have %1$d note. %2$s</item>
        <item quantity="other">You have %1$d notes, newest first. %2$s</item>
    </plurals>
    <plurals name="say_notif_list">
        <item quantity="one">You have %1$d notification. %2$s</item>
        <item quantity="other">You have %1$d notifications. %2$s</item>
    </plurals>
    <plurals name="duration_minutes">
        <item quantity="one">%1$d minute</item>
        <item quantity="other">%1$d minutes</item>
    </plurals>
    <plurals name="duration_hours">
        <item quantity="one">%1$d hour</item>
        <item quantity="other">%1$d hours</item>
    </plurals>
</resources>
